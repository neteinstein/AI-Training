{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-training",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Served at training.pedrovicente.pt (the zone is on this Cloudflare account). Wrangler creates
  // the DNS record and certificate on deploy. The workers.dev address stays off.
  "routes": [{ "pattern": "training.pedrovicente.pt", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Public values, read by the server at run time. The browser bundle gets the NEXT_PUBLIC_ ones
  // at build time instead, from the build's environment (see .github/workflows/deploy.yml).
  // Keep them in step with the deploy workflow. SUPABASE_SECRET_KEY is a Worker secret, never
  // written here: `npx wrangler secret put SUPABASE_SECRET_KEY`.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://wsyxnxtinvhnecmwkhzt.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_pszwONINzSRgWXkXdOUMFA_MvFvS4kU",
    "NEXT_PUBLIC_SITE_URL": "https://training.pedrovicente.pt",
  },
  "keep_vars": true,
  "kv_namespaces": [
    // Next.js cache ("use cache" entries)
    { "binding": "NEXT_INC_CACHE_KV", "id": "2e7c84ae27d146d5a4188f6b48f4035a" },
  ],
  "d1_databases": [
    // When each cache tag was last invalidated
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "ai-training-next-tags",
      "database_id": "13b1605f-fa75-422a-9c5a-baa79a3f4167",
    },
  ],
  "services": [
    // Self-reference used by OpenNext for background revalidation; must match "name".
    { "binding": "WORKER_SELF_REFERENCE", "service": "ai-training" },
  ],
  "observability": { "enabled": true },
}
