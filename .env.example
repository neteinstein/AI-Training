# Copy to .env.local. For local development, `npm run env:local` writes these
# values from the running local Supabase stack.

# Supabase project URL and publishable key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key. Server only: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public origin of the app, used in emails, metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
